# ==============================================================================
# إعدادات البيئة لموقع شركة الفضاء الواسع (Environment Variables)
# ==============================================================================

# رابط الواجهة الخلفية لنظام إدارة المراسلات (NestJS API)
# ⚠️ تنبيه هام جدًا (Static Export / Build-time Inlining):
# في وضع التصدير الثابت لـ Next.js (output: "export")، يتم دمج وحقن هذا المتغير
# أثناء وقت البناء (Build-time) مباشرة داخل ملفات JavaScript المولدة في out/.
# أي تغيير عليه لاحقاً يتطلب إعادة تشغيل: npm run build
#
# القيمة الافتراضية http://localhost:3000/api/v1 مخصصة للتطوير المحلي فقط
# ولن تعمل للمستخدمين النهائيين على الإنترنت إذا لم يتم استبدالها بنطاق الخادم السحابي الحقيقي.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# معرّف تحليلات جوجل (Google Analytics 4 ID - اختياري)
# مثال: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# عنوان الخادم الخلفي من جهة الخادم (Server Components / ISR) — لا يُكشف للعميل
API_BASE_URL=https://alfada-alwasaa-systame.onrender.com/api/v1
