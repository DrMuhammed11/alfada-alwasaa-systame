# ═══════════════════════════════════════════════════════════════
#  متغيرات البيئة — نظام إدارة المراسلات (الفضاء الواسع)
#  انسخ هذا الملف إلى ‎.env‎ ثم عدّل القيم حسب بيئتك:
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── قاعدة البيانات (PostgreSQL) ───
# نفس بيانات docker-compose.yml المرفق
# ملاحظة: لا تضع علامات اقتباس حول الرابط (Prisma لا يقبلها)
DATABASE_URL=postgresql://alfadaa:alfadaa@localhost:5432/alfadaa_correspondence?schema=public

# ─── الخادم ───
PORT=3000
# النطاقات المسموح لها بالاتصال (افصل بينها بفاصلة) — * للسماح للجميع
CORS_ORIGIN="*"

# ─── المصادقة (JWT) ───
# ⚠️ إلزامي: غيّر القيمة في الإنتاج إلى نص عشوائي طويل، مثال:
#    openssl rand -hex 64
JWT_SECRET="alfadaa-dev-secret-change-me"
JWT_EXPIRES_IN="12h"

# ─── البريد الإلكتروني ───
# console : طباعة الرسائل في الطرفية فقط (وضع التطوير — لا إرسال حقيقي)
# smtp    : إرسال حقيقي عبر خادم بريد الشركة (info@al-fadaa.com)
MAIL_DRIVER="console"
MAIL_FROM="info@al-fadaa.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── المرفقات ───
UPLOAD_DIR="./uploads"
