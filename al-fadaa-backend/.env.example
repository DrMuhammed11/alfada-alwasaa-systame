# ═══════════════════════════════════════════════════════════════
#  متغيرات البيئة — نظام إدارة المراسلات (الفضاء الواسع)
#  انسخ هذا الملف إلى ‎.env‎ ثم عدّل القيم حسب بيئتك:
#  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── قاعدة البيانات (PostgreSQL) ───
# نفس بيانات docker-compose.yml المرفق
# ملاحظة: لا تضع علامات اقتباس حول الرابط (Prisma لا يقبلها)
DATABASE_URL=postgresql://alfadaa:alfadaa@localhost:5432/alfadaa_correspondence?schema=public

# ─── الخادم ───
PORT=3000
# النطاقات المسموح لها بالاتصال (افصل بينها بفاصلة)
# ⚠️ في الإنتاج: يجب تحديد النطاقات بدقة — القائمة الفارغة أو * تمنع التشغيل
# مثال: CORS_ORIGIN="https://app.al-fadaa.com,https://admin.al-fadaa.com"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5000"

# ─── تحديد معدل الطلبات (Rate Limiting) ───
THROTTLE_TTL=60
THROTTLE_LIMIT=60
THROTTLE_LOGIN_LIMIT=5
THROTTLE_INQUIRY_LIMIT=5
THROTTLE_TRACK_LIMIT=15
# REDIS_URL="redis://localhost:6379" # اختياري لمخزن Throttler الموزع في الإنتاج

# ─── المصادقة (JWT) ───
# ⚠️ إلزامي: غيّر القيمة في الإنتاج إلى نص عشوائي طويل — النظام لا يعمل بدون هذا المتغير
#    openssl rand -hex 64
JWT_SECRET="alfadaa-dev-secret-change-me"
JWT_EXPIRES_IN="15m"  # access token قصير
JWT_ACCESS_EXPIRES_IN="15m"  # access token قصير
JWT_REFRESH_EXPIRES_IN_DAYS="30"  # refresh token طويل
JWT_ISSUER="alfadaa-api"
JWT_AUDIENCE="alfadaa-app"

# ─── البريد الإلكتروني ───
# console : طباعة الرسائل في الطرفية فقط (وضع التطوير — لا إرسال حقيقي)
# smtp    : إرسال حقيقي عبر خادم بريد الشركة (info@al-fadaa.com)
MAIL_DRIVER="console"
MAIL_FROM="info@al-fadaa.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── أمان IMAP ───
# ⚠️ في الإنتاج: اتركها فارغة (true افتراضياً) — تعطيل التحقق يفتح باب MITM
# للتطوير فقط: IMAP_TLS_REJECT_UNAUTHORIZED="false"
IMAP_TLS_REJECT_UNAUTHORIZED=""

# ─── المرفقات ───
UPLOAD_DIR="./uploads"
# ALLOW_ZIP_UPLOADS="true" # اختياري: السماح برفع ملفات ZIP (معطّل افتراضياً)

# ─── النسخ الاحتياطي لقاعدة البيانات (Database Backup) ───
BACKUP_ENABLED=true
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=7
BACKUP_CRON="0 2 * * *"
BACKUP_ALERT_EMAIL="admin@al-fadaa.com"
# رفع النسخ لمخزن خارجي (إلزامي على الأقراص الفانية مثل Render) — {file} للمسار و{name} لاسم الملف
# مثال: BACKUP_UPLOAD_COMMAND="rclone copyto {file} r2:alfadaa-backups/{name}"
BACKUP_UPLOAD_COMMAND=""

