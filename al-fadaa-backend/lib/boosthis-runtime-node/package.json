{
  "name": "@workspace/boosthis-runtime-node",
  "version": "1.0.0-alpha.187",
  "private": true,
  "type": "module",
  "description": "Boosthis performance runtime for Node.js / Express. Same scoring model and PII guard as the Python and React Native runtimes.",
  "exports": {
    ".": "./src/index.ts",
    "./middleware": "./src/middleware.ts",
    "./mount": "./src/mount.ts",
    "./mcp": "./src/mcp.ts",
    "./checklist": "./src/checklist.ts",
    "./hosting": "./src/hosting.ts",
    "./bun-limits": "./src/bunLimits.ts",
    "./rate-honesty": "./src/rateHonesty.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp-stdio.ts",
    "mcp-config": "tsx src/mcp-config.ts",
    "context": "tsx src/context-cli.ts"
  },
  "peerDependencies": {
    "express": ">=4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "boosthis-checklist": "workspace:*"
  },
  "devDependencies": {
    "@hapi/hapi": "^21.4.10",
    "@koa/router": "^15.7.0",
    "@types/express": "^4.17.21",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^15.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "express": "^4.21.2",
    "fastify": "^5.12.1",
    "koa": "^3.2.1",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "undici": "^7.29.0",
    "vitest": "catalog:"
  }
}
