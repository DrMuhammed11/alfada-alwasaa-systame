{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/schedule$": "<rootDir>/mocks/nestjs-schedule.mock.ts"
  },
  "globalSetup": "./global-setup.e2e.ts",
  "setupFiles": ["./setup-e2e.ts"],
  "testTimeout": 30000
}
